# =========================================
# GENERAL
# =========================================
TZ=Europe/London
COMPOSE_PROJECT_NAME=ai-rag-assistant

# =========================================
# DOMAIN / TLS
# =========================================
DOMAIN=rag-ai.example.com
EMAIL=admin@example.com

# =========================================
# POSTGRESQL
# =========================================
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=openwebui
POSTGRES_PORT=5432

# =========================================
# REDIS
# =========================================
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# =========================================
# QDRANT
# =========================================
QDRANT_API_KEY=CHANGE_ME_STRONG_QDRANT_KEY

# =========================================
# OPEN WEBUI
# =========================================
WEBUI_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
WEBUI_NAME="AI RAG Assistant"
DEFAULT_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
ENABLE_SIGNUP=false
ENABLE_RAG_HYBRID_SEARCH=true

# =========================================
# OLLAMA
# =========================================
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m

# =========================================
# CADDY / RATE LIMITING
# =========================================
CADDY_RATE_LIMIT_REQUESTS=100
CADDY_RATE_LIMIT_WINDOW=1m
UPLOAD_MAX_SIZE=500MB

# =========================================
# LOGGING
# =========================================
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
